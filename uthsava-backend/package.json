{
  "name": "uthsava-api",
  "version": "1.0.0",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc && tsc-alias && node scripts/copyAssets.cjs",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --transpile-only --no-notify --ignore-watch node_modules --ignore-watch dist --ignore-watch logs -r tsconfig-paths/register --respawn src/app.ts",
    "create:admin": "ts-node scripts/createAdmin.ts",
    "seed:users": "ts-node scripts/seedUsers.ts",
    "seed:static-pages": "ts-node -r tsconfig-paths/register scripts/seedStaticPages.ts",
    "seed:emails": "ts-node -r tsconfig-paths/register src/scripts/seed-email-templates.ts",
    "clean:countryCodes": "ts-node scripts/cleanCountryCodes.ts",
    "migrate:uploadedByRole": "ts-node -r tsconfig-paths/register src/scripts/migrate-uploadedByRole.ts",
    "check:pending": "ts-node -r tsconfig-paths/register src/scripts/check-pending-content.ts",
    "lint": "eslint \"{src,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{src,scripts}/**/*.ts\" --fix",
    "test": "node --max_old_space_size=8192 node_modules/jest/bin/jest.js --runInBand --logHeapUsage --forceExit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.497.0",
    "@aws-sdk/s3-request-presigner": "^3.497.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/json2csv": "^5.0.7",
    "@types/pdfkit": "^0.17.5",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.78.0",
    "connect-redis": "^7.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^4.0.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "express-session": "^1.17.3",
    "firebase-admin": "^12.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.0.0",
    "i18n": "^0.15.3",
    "ioredis": "^5.3.2",
    "joi": "^17.10.2",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^8.0.0",
    "mongoose-slug-plugin": "^2.1.0",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.11",
    "pdfkit-table": "^0.1.99",
    "redis": "^4.6.7",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.18.2",
    "@types/i18n": "^0.13.12",
    "@types/jest": "^29.5.14",
    "@types/joi": "^17.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.9",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.2"
  }
}
