<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title><%= subject %></title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');
        
        body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f3f4f6;
            color: #1f2937;
        }

        .email-wrapper {
            width: 100%;
            background-color: #f3f4f6;
            padding: 40px 0;
        }

        .email-card {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        }

        .email-header {
            background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            padding: 40px 30px;
            text-align: center;
        }

        .email-header h1 {
            color: #ffffff;
            margin: 0;
            font-size: 28px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .email-body {
            padding: 40px 30px;
            font-size: 16px;
            line-height: 1.6;
            color: #374151;
        }

        /* Styling for rich text generated content */
        .email-body h1, .email-body h2, .email-body h3, .email-body h4 {
            color: #111827;
            margin-top: 0;
            margin-bottom: 16px;
            font-weight: 600;
        }

        .email-body p {
            margin-top: 0;
            margin-bottom: 20px;
        }

        .email-body p:last-child {
            margin-bottom: 0;
        }

        .email-body a {
            color: #6366f1;
            text-decoration: none;
            font-weight: 600;
        }

        .email-body a:hover {
            text-decoration: underline;
        }

        .email-body blockquote {
            border-left: 4px solid #8b5cf6;
            background-color: #f5f3ff;
            margin: 0 0 20px 0;
            padding: 16px 20px;
            border-radius: 0 8px 8px 0;
            font-style: italic;
            color: #4c1d95;
        }

        .email-body ul, .email-body ol {
            padding-left: 20px;
            margin-bottom: 20px;
        }

        .email-body li {
            margin-bottom: 8px;
        }

        .email-body pre {
            background-color: #1f2937;
            color: #f3f4f6;
            padding: 16px;
            border-radius: 8px;
            overflow-x: auto;
            margin-bottom: 20px;
        }

        .email-body code {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 14px;
        }

        .email-footer {
            background-color: #f8fafc;
            padding: 30px;
            text-align: center;
            border-top: 1px solid #e2e8f0;
        }

        .email-footer p {
            color: #64748b;
            font-size: 13px;
            margin: 0 0 8px 0;
        }

        .email-footer a {
            color: #6366f1;
            text-decoration: none;
        }
        
        .email-footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <table class="email-wrapper" cellpadding="0" cellspacing="0" border="0">
        <tr>
            <td align="center">
                <table class="email-card" cellpadding="0" cellspacing="0" border="0" align="center">
                    <tr>
                        <td class="email-header">
                            <h1>Uthsava</h1>
                        </td>
                    </tr>
                    <tr>
                        <td class="email-body">
                            <!-- The raw HTML content from the rich text editor is injected here unescaped -->
                            <%- content %>
                        </td>
                    </tr>
                    <tr>
                        <td class="email-footer">
                            <p>© <%= new Date().getFullYear() %> Uthsava. All rights reserved.</p>
                            <p>Need help? Contact us at <a href="mailto:support@uthsava.com">support@uthsava.com</a></p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
